  return {
    __esModule: true,
    default: ({ title, onPress }) => (
      <TouchableOpacity onPress={onPress}>
        <Text>{title}</Text>
      </TouchableOpacity>
    ),
  };
});

// Mock Themeable to avoid native styling dependencies.
jest.mock('../common/components/Themeable', () => {
