// Mock onboarding configuration.
jest.mock('../common/network/killSwitchCache', () => {
  const moduleProperties = {
    binSetting: {
      isEnabled: false,
    },
  };

  class KillSwitchConfig {
    constructor() {
      this.moduleProperties = moduleProperties;
    }

    getMobileProperties() {
      return moduleProperties;
    }

    static getMobileProperties() {
      return moduleProperties;
    }
  }

  KillSwitchConfig.moduleProperties = moduleProperties;

  return {
    __esModule: true,
    default: KillSwitchConfig,
    KillSwitch: KillSwitchConfig,
    KillSwitchConfig: KillSwitchConfig,
    moduleProperties: moduleProperties,
  };
});
