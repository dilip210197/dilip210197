        },
      };
    }
  },
}));

// Keep the screen constants consistent with the component.
jest.mock('../common/constants/screenConstants', () => ({
  __esModule: true,
  default: {
    HOME_SCREEN: 'HOME_SCREEN',
    BIN_ENTRY_SCREEN: 'BIN_ENTRY_SCREEN',
  },
}));

// Mock the icon constants used by ITEMS.
jest.mock('../common/constants/iconConstants', () => ({
  __esModule: true,
  default: {
    ON_BOARDING_GRAPHIC_1: 'graphic_1',
    ON_BOARDING_GRAPHIC_2: 'graphic_2',
    ON_BOARDING_GRAPHIC_3: 'graphic_3',
    ON_BOARDING_GRAPHIC_4: 'graphic_4',
  },
}));

jest.mock('../common/constants/globalConstants', () => ({
  ANDROID_PADDING_BOTTOM: 0,
}));

jest.mock('../common/utils/initialStateCategories', () => ({
  initialStateCategory: {
    DEFAULT_UNIT: 'metric',
  },
}));

jest.mock('../common/styles/theme', () => ({
  getTheme: jest.fn(() => ({
    splashScreenStyle: {},
    DEFAULT_SPACE_TEN: 10,
    binEntryBackgroundColor: '#ffffff',
  })),
}));


// ITEMS mirror the production onboarding configuration.
const ITEMS = [
  {
    index: 1,
    key: 'welcome_screen',
    title: 'welcome_screen_text',
  },
  {
    index: 2,
    key: 'explore_screen',
    title: 'explore_screen_text',
  },
  {
    index: 3,
    key: 'find_screen',
    title: 'find_screen_text',
  },
  {
    index: 4,
    key: 'learn_screen',
    title: 'learn_screen_text',
  },
];

const getText = key => key;

const NEXT = getText('next').toUpperCase();
const GET_STARTED = getText('get_started').toUpperCase();
const SKIP = getText('skip');

describe('OnBoardingScreen', () => {
  let navigation;

  beforeEach(() => {
    jest.clearAllMocks();

    navigation = {
      dispatch: jest.fn(),
      navigate: jest.fn(),
    };
  });

  const renderOnboarding = () => {
    return render(
      <OnBoardingScreen navigation={navigation} />,
    );
  };

  const pressNext = async () => {
    const { getByText } = screen;

    await waitFor(() => {
      expect(getByText(NEXT)).toBeTruthy();
    });

    fireEvent.press(getByText(NEXT));
  };

  const navigateToLastSlide = async () => {
    for (let i = 0; i < ITEMS.length - 1; i++) {
      await pressNext();
    }
  };

  it('renders the onboarding screen', () => {
    const { getByTestId } = renderOnboarding();

    expect(getByTestId('mock-swiper')).toBeTruthy();
  });

  it('renders the first onboarding slide', () => {
    const { getByText } = renderOnboarding();

    expect(
      getByText(getText(ITEMS[0].key)),
    ).toBeTruthy();

    expect(
      getByText(getText(ITEMS[0].title)),
    ).toBeTruthy();
  });

  it('saves default unit on mount', async () => {
    renderOnboarding();

    await waitFor(() => {
      expect(Preference.set).toHaveBeenCalledWith(
        'DEFAULT_UNIT',
        expect.anything(),
      );
    });
  });

  it('shows Next button initially', () => {
    const { getByText } = renderOnboarding();

    expect(getByText(NEXT)).toBeTruthy();
  });

  it('moves to next slide when Next is pressed', async () => {
    const { getByText } = renderOnboarding();

    fireEvent.press(getByText(NEXT));

    await waitFor(() => {
      expect(
        getByText(getText(ITEMS[1].key)),
      ).toBeTruthy();
    });
  });

  it('moves through all four slides', async () => {
    const { getByText } = renderOnboarding();

    for (let i = 1; i < ITEMS.length; i++) {
      fireEvent.press(getByText(NEXT));

      await waitFor(() => {
        expect(
          getByText(getText(ITEMS[i].key)),
        ).toBeTruthy();
      });
    }
  });

  it('shows Get Started on final slide', async () => {
    const { getByText } = renderOnboarding();

    for (let i = 0; i < ITEMS.length - 1; i++) {
      fireEvent.press(getByText(NEXT));
    }

    await waitFor(() => {
      expect(getByText(GET_STARTED)).toBeTruthy();
    });
  });

  it('hides Skip on final slide', async () => {
    const { getByText, queryByText } = renderOnboarding();

    for (let i = 0; i < ITEMS.length - 1; i++) {
      fireEvent.press(getByText(NEXT));
    }

    await waitFor(() => {
      expect(queryByText(SKIP)).toBeNull();
    });
  });

  it('completes the final slide', async () => {
    const { getByText } = renderOnboarding();

    for (let i = 0; i < ITEMS.length - 1; i++) {
      fireEvent.press(getByText(NEXT));
    }

    await waitFor(() => {
      expect(getByText(GET_STARTED)).toBeTruthy();
    });

    fireEvent.press(getByText(GET_STARTED));

    await waitFor(() => {
      expect(Preference.set).toHaveBeenCalledWith(
        'FIRST_APP_LAUNCH',
        'true',
      );

      expect(CommonActions.reset).toHaveBeenCalled();
      expect(navigation.dispatch).toHaveBeenCalled();
    });
  });

  it('Skip completes onboarding', async () => {
    const { getByText } = renderOnboarding();

    fireEvent.press(getByText(SKIP));

    await waitFor(() => {
      expect(Preference.set).toHaveBeenCalledWith(
        'FIRST_APP_LAUNCH',
        'true',
      );

      expect(CommonActions.reset).toHaveBeenCalled();
      expect(navigation.dispatch).toHaveBeenCalled();
    });
  });
});
