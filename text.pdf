
import React from 'react';
import {
  render,
  fireEvent,
  act,
  waitFor,
} from '@testing-library/react-native';

import Preference from 'react-native-preference';
import { CommonActions } from '@react-navigation/native';

import OnBoardingScreen from '../modules/onboarding/OnBoardingScreen';

// Mock language provider before importing the screen.
jest.mock('../common/language/languageProvider', () => ({
  __esModule: true,
  default: class LanguageProvider {
    getText(key) {
      return key;
    }
  },
}));

// Mock native localization dependency.
jest.mock('react-native-localize', () => ({
  getLocales: jest.fn(() => [
    {
      languageCode: 'en',
      countryCode: 'US',
      languageTag: 'en-US',
      isRTL: false,
    },
  ]),
  getCountry: jest.fn(() => 'US'),
  getTimeZone: jest.fn(() => 'UTC'),
  findBestAvailableLanguage: jest.fn(() => ({
    languageTag: 'en',
    isRTL: false,
  })),
  addEventListener: jest.fn(),
  removeEventListener: jest.fn(),
}));

jest.mock('react-native-preference', () => ({
  __esModule: true,
  default: {
    set: jest.fn(),
    get: jest.fn(),
  },
}));

jest.mock('@react-navigation/native', () => ({
  CommonActions: {
    reset: jest.fn(config => ({
      type: 'RESET',
      payload: config,
    })),
  },
}));

// Swiper mock that maintains its current index.
jest.mock('react-native-swiper', () => {
  const React = require('react');
  const { View } = require('react-native');

  const Swiper = React.forwardRef((props, ref) => {
    const [index, setIndex] = React.useState(0);

    React.useImperativeHandle(ref, () => ({
      scrollBy: jest.fn(amount => {
        setIndex(previous => {
          const next = previous + amount;

          if (props.onIndexChanged) {
            props.onIndexChanged(next);
          }

          return next;
        });
      }),
    }));

    return (
      <View testID="mock-swiper">
        {React.Children.toArray(props.children)[index]}
      </View>
    );
  });

  return {
    __esModule: true,
    default: Swiper,
  };
});

// Mock icon rendering.
jest.mock('../common/components/Icon', () => {
  const { View } = require('react-native');

  return {
    __esModule: true,
    default: props => <View testID={props.iconName} />,
  };
});

// Mock button while preserving title and press handling.
jest.mock('../common/components/Button', () => {
