// Verify onboarding completion.
const verifyOnboardingCompletion = async () => {
  await waitFor(() => {
    expect(Preference.set).toHaveBeenCalledWith(
      'firstAppLaunch',
      'true',
    );

    expect(
      CommonActions.reset,
    ).toHaveBeenCalled();

    expect(
      navigation.dispatch,
    ).toHaveBeenCalled();
  });
};
