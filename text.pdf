const languageProvider = new LanguageProvider();

const NEXT = languageProvider.getText('next').toUpperCase();
const GET_STARTED = languageProvider.getText('get_started').toUpperCase();
const SKIP = languageProvider.getText('skip');

const navigateToLastSlide = async () => {
  for (let i = 0; i < ITEMS.length - 1; i++) {
    const nextButton = await screen.findByText(NEXT);

    fireEvent.press(nextButton);
  }
};

it('completes the final slide', async () => {
  render(<OnBoardingScreen />);

  await navigateToLastSlide();

  expect(
    screen.getByText(GET_STARTED)
  ).toBeTruthy();
});

jest.mock('react-native-localize', () => ({
  getLocales: jest.fn(() => [
    {
      languageCode: 'en',
      countryCode: 'US',
      languageTag: 'en-US',
      isRTL: false,
    },
  ]),
  getCountry: jest.fn(() => 'US'),
  getTimeZone: jest.fn(() => 'UTC'),
  findBestAvailableLanguage: jest.fn(() => ({
    languageTag: 'en',
    isRTL: false,
  })),
  addEventListener: jest.fn(),
  removeEventListener: jest.fn(),
}));

jest.mock('../common/language/languageProvider', () => ({
