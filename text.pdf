jest.mock('react-redux', () => ({
  ...jest.requireActual('react-redux'),

  connect: (mapState, mapDispatch) => Component => {
    Component.__mapStateToProps = mapState;
    Component.__mapDispatchToProps = mapDispatch;

    return Component;
  },
}));

const ScreenModule = require(
  '../modules/lounges/LoungesDetailsScreen'
);

const LoungesDetailsScreen =
  ScreenModule.LoungesDetailsScreen ||
  ScreenModule.default.WrappedComponent ||
  ScreenModule.default;

const mapStateToProps =
  ScreenModule.mapStateToProps ||
  LoungesDetailsScreen.__mapStateToProps;

const mapDispatchToProps =
  ScreenModule.mapDispatchToProps ||
  LoungesDetailsScreen.__mapDispatchToProps;
