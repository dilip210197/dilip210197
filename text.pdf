// Onboarding slide configuration.
const ITEMS = [
  {
    index: 1,
    key: 'welcome_screen',
    title: 'welcome_screen_text',
  },
  {
    index: 2,
    key: 'explore_screen',
    title: 'explore_screen_text',
  },
  {
    index: 3,
    key: 'find_screen',
    title: 'find_screen_text',
  },
  {
    index: 4,
    key: 'learn_screen',
    title: 'learn_screen_text',
  },
];

const getText = key => key;

const NEXT = getText('next').toUpperCase();

const GET_STARTED = getText(
  'get_started',
).toUpperCase();

const SKIP = getText('skip');

describe('OnBoardingScreen', () => {
  let navigation;

  beforeEach(() => {
    jest.clearAllMocks();

    navigation = {
      dispatch: jest.fn(),
      navigate: jest.fn(),
    };
  });

  // Render and wait for the initial slide.
  const renderOnboarding = async () => {
    await render(
      <OnBoardingScreen navigation={navigation} />,
    );

    await screen.findByText(
      getText(ITEMS[0].key),
    );
  };

  // Press Next and wait for the expected slide.
  const pressNext = async nextIndex => {
    const nextButton = await screen.findByText(
      NEXT,
    );

    await fireEvent.press(nextButton);

    await screen.findByText(
      getText(ITEMS[nextIndex].key),
    );
  };

  // Navigate sequentially to the final slide.
  const navigateToLastSlide = async () => {
    for (let i = 1; i < ITEMS.length; i++) {
      await pressNext(i);
    }

    await screen.findByText(GET_STARTED);
  };

  // Verify onboarding completion.
  const verifyOnboardingCompletion = async () => {
    await waitFor(() => {
      expect(Preference.set).toHaveBeenCalledWith(
        'FIRST_APP_LAUNCH',
        'true',
      );

      expect(
        CommonActions.reset,
      ).toHaveBeenCalled();

      expect(
        navigation.dispatch,
      ).toHaveBeenCalled();
    });
  };

  // Test case 1.
  it('renders the onboarding screen', async () => {
    await renderOnboarding();

    expect(
      screen.getByTestId('mock-swiper'),
    ).toBeTruthy();
  });

  // Test case 2.
  it('renders the first onboarding slide', async () => {
    await renderOnboarding();

    expect(
      screen.getByText(getText(ITEMS[0].key)),
    ).toBeTruthy();

    expect(
      screen.getByText(getText(ITEMS[0].title)),
    ).toBeTruthy();
  });

  // Test case 3.
  it('saves default unit on mount', async () => {
    await renderOnboarding();

    await waitFor(() => {
      expect(Preference.set).toHaveBeenCalledWith(
        'DEFAULT_UNIT',
        expect.anything(),
      );
    });
  });

  // Test case 4.
  it('shows Next button initially', async () => {
    await renderOnboarding();

    expect(
      await screen.findByText(NEXT),
    ).toBeTruthy();
  });

  // Test case 5.
  it('moves to next slide when Next is pressed', async () => {
    await renderOnboarding();

    await pressNext(1);

    expect(
      screen.getByText(getText(ITEMS[1].key)),
    ).toBeTruthy();
  });

  // Test case 6.
  it('moves through all four slides', async () => {
    await renderOnboarding();

    for (let i = 1; i < ITEMS.length; i++) {
      await pressNext(i);

      expect(
        screen.getByText(getText(ITEMS[i].key)),
      ).toBeTruthy();
    }
  });

  // Test case 7.
  it('shows Get Started on final slide', async () => {
    await renderOnboarding();

    await navigateToLastSlide();

    expect(
      screen.getByText(GET_STARTED),
    ).toBeTruthy();
  });

  // Test case 8.
  it('hides Skip on final slide', async () => {
    await renderOnboarding();

    await navigateToLastSlide();

    await waitFor(() => {
      expect(
        screen.queryByText(SKIP),
      ).toBeNull();
    });
  });

  // Test case 9.
  it('completes the final slide', async () => {
    await renderOnboarding();

    await navigateToLastSlide();

    const getStartedButton =
      await screen.findByText(GET_STARTED);

    await fireEvent.press(getStartedButton);

    await verifyOnboardingCompletion();
  });

  // Test case 10.
  it('Skip completes onboarding', async () => {
    await renderOnboarding();

    const skipButton =
      await screen.findByText(SKIP);

    await fireEvent.press(skipButton);

    await verifyOnboardingCompletion();
  });
});
