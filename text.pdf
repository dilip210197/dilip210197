
import React from 'react';
import { InteractionManager } from 'react-native';
import { render, fireEvent } from '@testing-library/react-native';
import Preference from 'react-native-preference';

import {
  LoungesDetailsScreen,
  mapStateToProps,
  mapDispatchToProps,
} from './LoungesDetailsScreen';

import BaseComponent from '../../common/components/BaseComponent';
import loungesConfig from './loungeConfiguration';
import devConfig from '../../common/config/devConfig';

import {
  HAVERSINE_DISTANCE,
  setNavigatorForTitle,
  openWebViewScreen,
  PARTNER_BIN,
  getNoAOPCLounges,
  getPreBookingLounges,
} from '../../common/utils/commonUtils';

import {
  _trackEvent,
  _trackScreen,
} from '../../common/analytics/analyticsTracking';

import {
  NAVIGATION_BAR_HEIGHT,
  PRIORITYPASS_LOGIN_URL,
  PRIORITYPASS_REGISTER_URL,
} from '../../common/constants/globalConstants';

import screenConstants from '../../common/constants/screenConstants';

// ==========================================
// MOCKS
// ==========================================

jest.mock('../../common/components/BaseComponent', () => {
  const React = require('react');

  return class BaseComponent extends React.Component {
    componentDidMount() {}
    componentDidAppear() {}
    componentWillUnmount() {}
    _onNavigatorEvent() {}
  };
});

jest.mock('react-native-preference', () => ({
  get: jest.fn(),
  set: jest.fn(),
}));

jest.mock('../../common/config/devConfig', () => ({
  useRedesign: true,
}));

jest.mock('./loungeConfiguration', () => jest.fn());

jest.mock('../../common/utils/commonUtils', () => ({
  HAVERSINE_DISTANCE: jest.fn(() => 10),
  milesToKm: jest.fn(value => value * 1.60934),
  setNavigatorForTitle: jest.fn(),
  openWebViewScreen: jest.fn(),
  PARTNER_BIN: 'PARTNER_BIN',
  PARTNER_BIN_COUNTRY: 'PARTNER_BIN_COUNTRY',
  _generateHtmlStyles: jest.fn(() => ({})),
  decodeHTML: jest.fn(value => value || ''),
  getIcon: jest.fn(() => 1),
  getNoAOPCLounges: jest.fn(() => []),
  getPreBookingLounges: jest.fn(() => []),
}));

jest.mock(
  '../../common/analytics/analyticsTracking',
  () => ({
    _trackEvent: jest.fn(),
    _trackScreen: jest.fn(),
  })
);

jest.mock('../../common/components/Themeable', () => {
  return ({ children }) => children;
});

jest.mock(
  '../../common/components/MapView',
  () => 'DCIMapView'
);

jest.mock(
  '../../common/components/Icon',
  () => 'Icon'
);

jest.mock(
  '../../common/components/DCITopBar',
  () => 'DCITopBar'
);

jest.mock(
  '../../common/components/SectionView',
  () => 'SectionView'
);

jest.mock(
  '../../common/components/HeaderTitleNew',
  () => 'HeaderTitleNew'
);

jest.mock(
  '../../common/components/Modal',
  () => {
    return ({ children, modalVisible }) =>
      modalVisible ? children : null;
  }
);

jest.mock(
  './components/LoungesDetailsHeaderPart',
  () => 'LoungesDetailsHeaderPart'
);

jest.mock(
  './components/LoungesRating',
  () => 'LoungesRating'
);

jest.mock(
  './components/PriorityPassScreen',
  () => 'PriorityPassScreen'
);

jest.mock(
  './components/HdfcCustomerScreen',
  () => 'HdfcCustomerScreen'
);

jest.mock(
  'react-native-linear-gradient',
  () => 'LinearGradient'
);

jest.mock('react-native-htmlview', () => {
  const React = require('react');
  const { Text } = require('react-native');

  return ({ value, testID }) => (
    <Text testID={testID}>{value}</Text>
  );
});

jest.mock(
  'react-native-hyperlink',
  () => ({ children }) => children
);

jest.mock('react-native-safe-area-context', () => ({
  SafeAreaView: require('react-native').View,
}));

jest.mock('../../common/styles/baseStyles', () => {
  return jest.fn(() => ({
    detailsContainerStyle: {},
    sectionContainerStyle: {},
  }));
});

jest.mock('./loungesAction', () => ({
  getAmenities: jest.fn(),
}));

jest.mock('../../common/global/globalActions', () => ({
  hidePriorityPassScreen: jest.fn(value => ({
    type: 'HIDE_PRIORITY_PASS',
    payload: value,
  })),
}));

// ==========================================
// GLOBAL MOCKS
// ==========================================

global.LanguageProvider = {
  getText: jest.fn(key => key),
};

global.KillSwitch = {
  moduleProperties: {
    priorityPass: {
      isEnabled: true,
    },
    HDFCCustomer: {
      isEnabled: false,
    },
  },
};

global.ThemeConfiguration = {
  primaryNavigationBarColor: '#FFFFFF',
  primaryNavBarTextColor: '#000000',
  tabIconSelectedColor: '#000000',
  navBarTextColor: '#FFFFFF',
  drawerContentOverlayColor: '#FFFFFF',
  newHeaderPrimaryTitleColor: '#000000',
  newHeaderNavigationBackgroundColor: '#FFFFFF',
  DEFAULT_SPACING_SIXTY: 60,
  DEFAULT_SPACING_TWENTY: 20,
  iosMinimumHeightFactor: 1,
  androidMinimumHeightFactor: 1,
  modifiedAccordionSectionStyle: {},
};

// ==========================================
// MOCK DATA
// ==========================================

const defaultConfig = {
  isOpenHoursHidden: false,
  isLocationHidden: false,
  isAmenitiesHidden: false,
  isPricingHidden: false,
  isConditionsHidden: false,
  optionsConfig: {},
};

const createProps = () => ({
  componentId: 'LoungesDetailsScreen',

  navigation: {
    navigate: jest.fn(),
    push: jest.fn(),
    goBack: jest.fn(),
    setOptions: jest.fn(),
    addListener: jest.fn(() => jest.fn()),
  },

  route: {
    params: {
      isFromFavorite: false,
      lounges: {
        media: [
          {
            url: 'https://example.com/lounge.png',
          },
        ],
        title: 'Airport Lounge',
        airport_name: 'Chennai Airport',
        lounge_name: 'Test Lounge',
        terminal: 'Terminal 1',
        rating_average: 4,
        rating_count: 20,
        dci_code: 'TEST001',
        telephone: '1234567890',
        openHoursData: '24 Hours',
        lounge_status: 'Open',
        point: [80.2707, 13.0827],
        city: 'Chennai',
        facilities: 'WIFI,FOOD',
        location: 'Near Gate 10',
        loungeDistance: 10,
        slug: 'test-lounge',
        additional: 'Additional Information',
        country: 'India',
        countryCode: 'IN',
        conditions: 'Valid membership required',
        guest_fee_rate: 0,
        currGeoLocation: [80.25, 13.05],
        refreshCount: 0,
        loungesData: [],
      },
    },
  },

  globalActions: {
    hidePriorityPassScreen: jest.fn(),
    setPriorityPassHeaderVisibility: jest.fn(),
    setBINTopBarVisibility: jest.fn(),
  },

  loungesAction: {
    getAmenities: jest.fn(),
  },

  amenities: {
    WIFI: {
      iconName: 'wifi',
      text: 'WiFi',
    },
    FOOD: {
      iconName: 'food',
      text: 'Food',
    },
  },

  isLoading: false,
  isFail: false,
  isImperial: false,
  distanceUnit: 'km',
  connectionState: true,
  shouldShowBINTopBar: false,
  shouldShowPriorityPassTopBar: false,
  redirectSSOUrl: '',
});

// ==========================================
// UNIT TESTS
// ==========================================

describe('LoungesDetailsScreen', () => {
  let instance;
  let props;

  beforeEach(() => {
    jest.clearAllMocks();

    loungesConfig.mockReturnValue({
      ...defaultConfig,
    });

    Preference.get.mockReturnValue(undefined);

    getNoAOPCLounges.mockReturnValue([]);
    getPreBookingLounges.mockReturnValue([]);

    devConfig.useRedesign = true;

    global.KillSwitch.moduleProperties = {
      priorityPass: {
        isEnabled: true,
      },
      HDFCCustomer: {
        isEnabled: false,
      },
    };

    jest
      .spyOn(InteractionManager, 'runAfterInteractions')
      .mockImplementation(callback => {
        callback();

        return {
          cancel: jest.fn(),
        };
      });

    props = createProps();

    instance = new LoungesDetailsScreen(props);

    instance.setState = jest.fn((update, callback) => {
      const nextState =
        typeof update === 'function'
          ? update(instance.state, instance.props)
          : update;

      instance.state = {
        ...instance.state,
        ...nextState,
      };

      if (callback) {
        callback();
      }
    });
  });

  afterEach(() => {
    jest.restoreAllMocks();
  });

  // ========================================
  // CONSTRUCTOR
  // ========================================

  test('initializes default state', () => {
    expect(instance.state.modalVisible).toBe(false);
    expect(instance.state.showCrossIcon).toBe(false);
    expect(instance.state.openHours).toBeUndefined();
    expect(instance.state.periods).toBeUndefined();
    expect(instance.state.title).toBe('');
    expect(instance.state.shouldShowTopBar).toBe(true);
    expect(instance.state.showTravelTypePopUp).toBe(true);

    expect(
      instance.state.modalPriorityPassVisible
    ).toBe(false);

    expect(instance._navBarUpdatedOnScroll).toBe(false);
    expect(instance._openedHours).toBeNull();
    expect(instance._showPriorityPassScreen).toBe(true);
    expect(instance.isIssuerTopBarVisible).toBe(false);
    expect(instance.ScrollView).toBeDefined();
  });

  // ========================================
  // INTEGER VALIDATION
  // ========================================

  test.each([0, 1, 10, -5])(
    'returns true for integer %s',
    value => {
      expect(instance._isInteger(value)).toBe(true);
    }
  );

  test.each([1.5, 2.75, -3.5, NaN])(
    'returns false for non-integer %s',
    value => {
      expect(instance._isInteger(value)).toBe(false);
    }
  );

  // ========================================
  // URL VALIDATION
  // ========================================

  test.each([
    ['https://example.com', true],
    ['http://example.com', true],
    ['Visit https://example.com', true],
    ['Open 24 Hours', false],
    ['', false],
  ])('validates URL %s', (value, expected) => {
    expect(instance._containsURL(value)).toBe(expected);
  });

  // ========================================
  // MAP MARKER
  // ========================================

  test.each([
    ['Terminal 1', 'Terminal 1, Chennai, India'],
    ['', 'Chennai, India'],
    [undefined, 'Chennai, India'],
  ])('generates marker for terminal %s', (terminal, address) => {
    props.route.params.lounges.terminal = terminal;

    expect(
      instance._getMarkerDataSource([80.2707, 13.0827])
    ).toEqual({
      coordinate: {
        latitude: 13.0827,
        longitude: 80.2707,
      },
      title: 'Test Lounge',
      description: terminal,
      locationName: 'Test Lounge',
      address,
    });
  });

  test('navigates to bigger map view', () => {
    const point = [80.2707, 13.0827];

    instance._redirectToBiggerMapView(point);

    expect(props.navigation.push).toHaveBeenCalledWith(
      screenConstants.MAP_SCREEN,
      {
        markerDataSource: [
          instance._getMarkerDataSource(point),
        ],
        selectedIndex: 0,
      }
    );
  });

  test('updates selected map location', () => {
    const location = {
      latitude: 13,
      longitude: 80,
    };

    instance._getLocationOnMap(location);

    expect(
      instance.state.currentSelectedStore
    ).toEqual(location);
  });

  // ========================================
  // DISTANCE
  // ========================================

  test.each([
    [false, 'km'],
    [true, 'mi'],
  ])('calculates distance for imperial %s', (imperial, unit) => {
    instance.props = {
      ...props,
      isImperial: imperial,
      distanceUnit: unit,
    };

    const point = [80, 13];

    expect(
      instance._getDistanceAndUnit(point)
    ).toEqual({
      distance: 10,
      distanceUnit: unit,
    });

    expect(HAVERSINE_DISTANCE).toHaveBeenCalledWith(
      props.route.params.lounges.currGeoLocation,
      point,
      imperial
    );
  });

  // ========================================
  // RATING MODAL
  // ========================================

  test('opens rating modal and tracks event', () => {
    instance._toggleModal();

    expect(instance.state.modalVisible).toBe(true);
    expect(instance.state.showCrossIcon).toBe(false);
    expect(_trackEvent).toHaveBeenCalled();
  });

  test('closes rating modal', () => {
    instance.state.modalVisible = true;
    instance.state.showCrossIcon = true;

    instance._toggleModal();

    expect(instance.state.modalVisible).toBe(false);
    expect(instance.state.showCrossIcon).toBe(false);
    expect(_trackEvent).not.toHaveBeenCalled();
  });

  // ========================================
  // TRAVEL POPUP AND CLOSE ICON
  // ========================================

  test.each([true, false])(
    'toggles travel popup to %s',
    value => {
      instance._toggleTravelTypePopUp(value);

      expect(
        instance.state.showTravelTypePopUp
      ).toBe(value);
    }
  );

  test.each([true, false])(
    'toggles close icon to %s',
    value => {
      instance._toggleCloseIcon(value);

      expect(instance.state.showCrossIcon).toBe(value);
    }
  );

  // ========================================
  // PRIORITY PASS MODAL
  // ========================================

  test.each([true, false])(
    'toggles Priority Pass modal to %s',
    value => {
      instance._togglePriorityPassModal(value);

      expect(
        instance.state.modalPriorityPassVisible
      ).toBe(value);
    }
  );

  test('presents Priority Pass screen', () => {
    instance.state.showTravelTypePopUp = false;

    instance._presentPriorityPassScreen();

    expect(
      instance.state.modalPriorityPassVisible
    ).toBe(true);

    expect(
      instance.state.showTravelTypePopUp
    ).toBe(true);
  });

  test('navigates to BIN entry screen', () => {
    instance._navigateToBINEntryScreen();

    expect(props.navigation.push).toHaveBeenCalledWith(
      screenConstants.BIN_ENTRY_SCREEN,
      {
        isFromLounge: true,
      }
    );
  });

  // ========================================
  // WEBVIEW
  // ========================================

  test('opens information screen', () => {
    instance._openWebView(true);

    expect(
      instance.state.showTravelTypePopUp
    ).toBe(false);

    expect(
      props.navigation.navigate
    ).toHaveBeenCalledWith('HOME_STACK_TAB', {
      screen: 'INFO_SCREEN',
    });
  });

  test('opens Priority Pass from travel popup', () => {
    const spy = jest
      .spyOn(instance, '_openPriorityPassWebView')
      .mockImplementation(() => {});

    instance._openWebView(false);

    expect(spy).toHaveBeenCalledWith(true);
    expect(instance.state.showTravelTypePopUp).toBe(false);
  });

  test.each([
    [true, PRIORITYPASS_LOGIN_URL],
    [false, PRIORITYPASS_REGISTER_URL],
  ])('opens Priority Pass URL for %s', (value, url) => {
    const spy = jest
      .spyOn(instance, '_openIssuerWebView')
      .mockImplementation(() => {});

    instance.state.modalPriorityPassVisible = true;

    instance._openPriorityPassWebView(value);

    expect(
      instance.state.modalPriorityPassVisible
    ).toBe(false);

    expect(spy).toHaveBeenCalledWith(url);
  });

  test('opens issuer WebView', () => {
    const url = 'https://example.com';

    instance._openIssuerWebView(url);

    expect(openWebViewScreen).toHaveBeenCalled();

    expect(
      openWebViewScreen.mock.calls[0][0]
    ).toBe(props.navigation);

    expect(
      openWebViewScreen.mock.calls[0][1]
    ).toBe(url);
  });

  // ========================================
  // KILL SWITCH
  // ========================================

  test.each([true, false])(
    'sets HDFC customer flag to %s',
    value => {
      global.KillSwitch.moduleProperties.HDFCCustomer = {
        isEnabled: value,
      };

      instance._setupKillSwitch();

      expect(instance.isHDFCCustomer).toBe(value);
    }
  );

  test('handles missing kill switch configuration', () => {
    global.KillSwitch.moduleProperties = {};

    instance._setupKillSwitch();

    expect(instance.isHDFCCustomer).toBe(false);
  });

  // ========================================
  // NAVIGATION TITLE
  // ========================================

  test('sets navigation title for redesign', () => {
    devConfig.useRedesign = true;

    instance._setNavBarTitle();

    expect(
      props.navigation.setOptions
    ).toHaveBeenCalledWith(
      expect.objectContaining({
        headerShown: true,
        title: '',
      })
    );
  });

  test('sets navigation title for legacy design', () => {
    devConfig.useRedesign = false;

    instance._setNavBarTitle();

    expect(setNavigatorForTitle).toHaveBeenCalled();
  });

  // ========================================
  // SCROLL EVENTS
  // ========================================

  test.each([
    [NAVIGATION_BAR_HEIGHT + 100, true],
    [0, false],
  ])('updates scroll flag at %s', (y, expected) => {
    instance.isIssuerTopBarVisible = true;

    instance._changeNavBarText({
      nativeEvent: {
        contentOffset: { y },
      },
    });

    expect(
      instance._navBarUpdatedOnScroll
    ).toBe(expected);
  });

  test('updates title when scrolled down', () => {
    instance.isIssuerTopBarVisible = false;

    instance._changeNavBarText({
      nativeEvent: {
        contentOffset: {
          y: NAVIGATION_BAR_HEIGHT + 100,
        },
      },
    });

    expect(instance.state.title).toBe(
      'Test Lounge - Terminal 1'
    );

    expect(
      props.navigation.setOptions
    ).toHaveBeenCalled();
  });

  test('updates legacy navigation on scroll', () => {
    devConfig.useRedesign = false;
    instance.isIssuerTopBarVisible = false;

    instance._changeNavBarText({
      nativeEvent: {
        contentOffset: {
          y: NAVIGATION_BAR_HEIGHT + 100,
        },
      },
    });

    expect(setNavigatorForTitle).toHaveBeenCalled();
  });

  test('closes top bar when scrolled to top', () => {
    instance.isIssuerTopBarVisible = false;

    const spy = jest
      .spyOn(instance, '_closeTopBar')
      .mockImplementation(() => {});

    instance._changeNavBarText({
      nativeEvent: {
        contentOffset: { y: 0 },
      },
    });

    expect(spy).toHaveBeenCalled();
  });

  // ========================================
  // CLOSE TOP BAR
  // ========================================

  test('closes top bar in redesign mode', () => {
    instance._closeTopBar();

    expect(
      props.globalActions.hidePriorityPassScreen
    ).toHaveBeenCalledWith(true);

    expect(instance.state.shouldShowTopBar).toBe(false);
    expect(instance._showPriorityPassScreen).toBe(false);

    expect(
      props.navigation.setOptions
    ).toHaveBeenCalledWith(
      expect.objectContaining({
        headerShown: true,
        title: '',
      })
    );
  });

  test.each([true, false])(
    'closes legacy top bar with scroll flag %s',
    scrolled => {
      devConfig.useRedesign = false;
      instance._navBarUpdatedOnScroll = scrolled;

      instance._closeTopBar();

      expect(
        props.navigation.setOptions
      ).toHaveBeenCalledWith(
        expect.objectContaining({
          headerShown: true,
          title: scrolled
            ? 'Test Lounge - Terminal 1'
            : '',
        })
      );
    }
  );

  // ========================================
  // PRIORITY PASS TOP BAR
  // ========================================

  test('renders BIN top bar without partner BIN', () => {
    Preference.get.mockReturnValue(undefined);

    instance.props = {
      ...props,
      shouldShowBINTopBar: true,
    };

    const spy = jest
      .spyOn(instance, 'generateTopBar')
      .mockReturnValue(null);

    instance._renderPriorityPassTopBar();

    expect(spy).toHaveBeenCalledWith(false);
    expect(instance.isIssuerTopBarVisible).toBe(true);
  });

  test('renders Priority Pass top bar with partner BIN', () => {
    Preference.get.mockReturnValue('TEST_BIN');

    instance.isPriorityPassEnabled = true;

    instance.props = {
      ...props,
      shouldShowPriorityPassTopBar: true,
    };

    const spy = jest
      .spyOn(instance, 'generateTopBar')
      .mockReturnValue(null);

    instance._renderPriorityPassTopBar();

    expect(spy).toHaveBeenCalledWith(true);
    expect(instance.isIssuerTopBarVisible).toBe(true);
  });

  test('hides Priority Pass top bar', () => {
    instance.state.shouldShowTopBar = false;

    const spy = jest
      .spyOn(instance, '_closeTopBar')
      .mockImplementation(() => {});

    instance._renderPriorityPassTopBar();

    expect(spy).toHaveBeenCalled();
    expect(instance.isIssuerTopBarVisible).toBe(false);
  });

  test.each([true, false])(
    'generates top bar for registered flag %s',
    registered => {
      const result = instance.generateTopBar(registered);

      expect(React.isValidElement(result)).toBe(true);

      expect(result.props.onRequestClose).toBe(
        instance._closeTopBar
      );

      expect(result.props.onItemPress).toBe(
        registered
          ? instance._presentPriorityPassScreen
          : instance._navigateToBINEntryScreen
      );

      expect(
        props.navigation.setOptions
      ).toHaveBeenCalled();
    }
  );

  test.each([true, false])(
    'renders Priority Pass for HDFC flag %s',
    isHDFC => {
      instance.isHDFCCustomer = isHDFC;
      instance.isPriorityPassEnabled = true;
      instance.state.modalPriorityPassVisible = true;
      instance.state.showTravelTypePopUp = true;

      Preference.get.mockReturnValue('TEST_BIN');

      const result = instance._renderPriorityPass();

      expect(React.isValidElement(result)).toBe(true);
      expect(result.props.modalVisible).toBe(true);
    }
  );

  test('hides Priority Pass when disabled', () => {
    instance.isPriorityPassEnabled = false;

    const result = instance._renderPriorityPass();

    expect(result.props.modalVisible).toBe(false);
  });

  // ========================================
  // LIFECYCLE METHODS
  // ========================================

  test('tracks screen on componentDidMount', () => {
    instance.componentDidMount();

    expect(_trackScreen).toHaveBeenCalled();
  });

  test('calls parent navigator event', () => {
    const spy = jest.spyOn(
      BaseComponent.prototype,
      '_onNavigatorEvent'
    );

    const event = {
      id: 'testEvent',
    };

    instance._onNavigatorEvent(event);

    expect(spy).toHaveBeenCalledWith(event);
  });

  test('calls parent componentWillUnmount', () => {
    const spy = jest.spyOn(
      BaseComponent.prototype,
      'componentWillUnmount'
    );

    instance.componentWillUnmount();

    expect(spy).toHaveBeenCalled();
  });

  test.each([true, false])(
    'handles componentWillAppear with top bar %s',
    visible => {
      instance.props = {
        ...props,
        shouldShowBINTopBar: visible,
      };

      const renderSpy = jest
        .spyOn(instance, '_renderPriorityPassTopBar')
        .mockImplementation(() => {});

      const closeSpy = jest
        .spyOn(instance, '_closeTopBar')
        .mockImplementation(() => {});

      instance.componentWillAppear();

      if (visible) {
        expect(renderSpy).toHaveBeenCalled();
      } else {
        expect(closeSpy).toHaveBeenCalled();
      }
    }
  );

  test.each([true, false])(
    'handles componentDidAppear with top bar %s',
    visible => {
      instance.props = {
        ...props,
        shouldShowBINTopBar: visible,
      };

      const renderSpy = jest
        .spyOn(instance, '_renderPriorityPassTopBar')
        .mockImplementation(() => {});

      const closeSpy = jest
        .spyOn(instance, '_closeTopBar')
        .mockImplementation(() => {});

      instance.componentDidAppear();

      if (visible) {
        expect(renderSpy).toHaveBeenCalled();
      } else {
        expect(closeSpy).toHaveBeenCalled();
      }
    }
  );

  test('updates top bar when BIN visibility changes', () => {
    const renderSpy = jest
      .spyOn(instance, '_renderPriorityPassTopBar')
      .mockImplementation(() => {});

    const setupSpy = jest.spyOn(
      instance,
      '_setupKillSwitch'
    );

    instance.componentDidUpdate({
      shouldShowBINTopBar: true,
    });

    expect(renderSpy).toHaveBeenCalled();
    expect(setupSpy).toHaveBeenCalled();
  });

  test('does not update top bar for unchanged props', () => {
    const renderSpy = jest
      .spyOn(instance, '_renderPriorityPassTopBar')
      .mockImplementation(() => {});

    instance.componentDidUpdate({
      shouldShowBINTopBar: false,
    });

    expect(renderSpy).not.toHaveBeenCalled();
  });

  // ========================================
  // RENDER HELPER METHODS
  // ========================================

  test('renders entry condition title', () => {
    const view = render(
      instance._getEntryConditionTitle()
    );

    expect(
      view.getByText('active_valid_dci_card')
    ).toBeTruthy();
  });

  test('renders conditions body', () => {
    const view = render(instance._conditionsBody());

    expect(
      view.getByText('Valid membership required')
    ).toBeTruthy();
  });

  test('renders additional information', () => {
    const view = render(
      instance._getAdditionalInfoBody('Test Information')
    );

    expect(
      view.getByText('Test Information')
    ).toBeTruthy();
  });

  test('renders opening hours', () => {
    const view = render(
      instance._renderOpenHours('Open', '24 Hours')
    );

    expect(view.getByText('24 Hours')).toBeTruthy();
  });

  test('renders empty opening hours', () => {
    const view = render(
      instance._renderOpenHours('Open', '')
    );

    expect(
      view.queryByTestId('Text_Lounge_ConditionData')
    ).toBeNull();
  });

  test('renders lounge amenities', () => {
    const view = render(
      instance._renderAmenities('WIFI,FOOD')
    );

    expect(view.getByText('WiFi')).toBeTruthy();
    expect(view.getByText('Food')).toBeTruthy();
  });

  test('renders pre-booking note', () => {
    const result = instance._renderPreBookingNote(
      'https://example.com/booking'
    );

    expect(React.isValidElement(result)).toBe(true);
  });

  test.each([0, 25])(
    'renders pricing with guest fee %s',
    fee => {
      props.route.params.lounges.guest_fee_rate = fee;

      const result = instance._getPricingBody();

      expect(React.isValidElement(result)).toBe(true);
    }
  );

  test('renders back button', () => {
    const result = instance._renderBack();

    expect(React.isValidElement(result)).toBe(true);

    result.props.children.props.onPress();

    expect(
      props.navigation.navigate
    ).toHaveBeenCalledWith(
      screenConstants.HOME_STACK_TAB
    );
  });

  // ========================================
  // FULL SCREEN RENDER
  // ========================================

  test('renders lounge details screen', () => {
    const view = render(
      <LoungesDetailsScreen {...props} />
    );

    expect(
      view.getByTestId('Touchable_Lounge_Map')
    ).toBeTruthy();

    expect(view.getByText('Hours')).toBeTruthy();
    expect(view.getByText('24 Hours')).toBeTruthy();
    expect(view.getByText('Amenities')).toBeTruthy();
    expect(view.getByText('WiFi')).toBeTruthy();
  });

  test('navigates when map is pressed', () => {
    const view = render(
      <LoungesDetailsScreen {...props} />
    );

    fireEvent.press(
      view.getByTestId('Touchable_Lounge_Map')
    );

    expect(props.navigation.push).toHaveBeenCalledWith(
      screenConstants.MAP_SCREEN,
      expect.objectContaining({
        selectedIndex: 0,
      })
    );
  });

  test('hides location section', () => {
    loungesConfig.mockReturnValue({
      ...defaultConfig,
      isLocationHidden: true,
    });

    const view = render(
      <LoungesDetailsScreen {...props} />
    );

    expect(
      view.queryByTestId('Touchable_Lounge_Map')
    ).toBeNull();
  });

  test('hides opening hours section', () => {
    loungesConfig.mockReturnValue({
      ...defaultConfig,
      isOpenHoursHidden: true,
    });

    const view = render(
      <LoungesDetailsScreen {...props} />
    );

    expect(view.queryByText('24 Hours')).toBeNull();
  });

  test('hides amenities section', () => {
    loungesConfig.mockReturnValue({
      ...defaultConfig,
      isAmenitiesHidden: true,
    });

    const view = render(
      <LoungesDetailsScreen {...props} />
    );

    expect(view.queryByText('Amenities')).toBeNull();
    expect(view.queryByText('WiFi')).toBeNull();
  });

  test('hides pricing section', () => {
    loungesConfig.mockReturnValue({
      ...defaultConfig,
      isPricingHidden: true,
    });

    const view = render(
      <LoungesDetailsScreen {...props} />
    );

    expect(
      view.queryByText('lounge_pricing')
    ).toBeNull();
  });

  test('hides entry conditions section', () => {
    loungesConfig.mockReturnValue({
      ...defaultConfig,
      isConditionsHidden: true,
    });

    const view = render(
      <LoungesDetailsScreen {...props} />
    );

    expect(
      view.queryByTestId('Lounges_Conditions')
    ).toBeNull();
  });

  test('handles empty facilities', () => {
    props.route.params.lounges.facilities = '';

    const view = render(
      <LoungesDetailsScreen {...props} />
    );

    expect(view.queryByText('Amenities')).toBeNull();
  });

  test('handles empty additional information', () => {
    props.route.params.lounges.additional = '';

    const view = render(
      <LoungesDetailsScreen {...props} />
    );

    expect(
      view.queryByText('additional_info')
    ).toBeNull();
  });

  test('handles empty conditions', () => {
    props.route.params.lounges.conditions = '';

    const view = render(
      <LoungesDetailsScreen {...props} />
    );

    expect(
      view.queryByTestId('Lounges_Conditions')
    ).toBeNull();
  });

  test('renders without lounge image', () => {
    props.route.params.lounges.media = [];

    const view = render(
      <LoungesDetailsScreen {...props} />
    );

    expect(
      view.getByTestId('Touchable_Lounge_Map')
    ).toBeTruthy();
  });

  test('renders with imperial distance', () => {
    props.isImperial = true;
    props.distanceUnit = 'mi';

    const view = render(
      <LoungesDetailsScreen {...props} />
    );

    expect(
      view.getByTestId('Text_Lounge_Airport')
    ).toBeTruthy();
  });

  test('renders important lounge note', () => {
    getNoAOPCLounges.mockReturnValue([
      {
        dci_code: 'TEST001',
      },
    ]);

    const view = render(
      <LoungesDetailsScreen {...props} />
    );

    expect(
      view.getAllByTestId('Text_Imp_Notes_Header').length
    ).toBeGreaterThan(0);
  });

  // ========================================
  // REDUX
  // ========================================

  test('maps Redux state to props', () => {
    const state = {
      lounges: {
        isLoading: true,
        isFail: false,
        amenitiesResult: {
          WIFI: {},
        },
        redirectSSOUrl: 'https://example.com',
      },
      global: {
        distanceUnit: 'km',
        isImperial: false,
        connectionState: true,
        shouldShowBINTopBar: true,
        shouldShowPriorityPassTopBar: false,
      },
    };

    expect(mapStateToProps(state)).toEqual({
      isLoading: true,
      isFail: false,
      amenities: {
        WIFI: {},
      },
      distanceUnit: 'km',
      isImperial: false,
      connectionState: true,
      shouldShowBINTopBar: true,
      shouldShowPriorityPassTopBar: false,
      redirectSSOUrl: 'https://example.com',
    });
  });

  test('maps Redux dispatch to props', () => {
    const dispatch = jest.fn();

    const result = mapDispatchToProps(dispatch);

    expect(result.globalActions).toBeDefined();
    expect(result.loungesAction).toBeDefined();

    result.globalActions.hidePriorityPassScreen(true);

    expect(dispatch).toHaveBeenCalledWith({
      type: 'HIDE_PRIORITY_PASS',
      payload: true,
    });
  });
});
